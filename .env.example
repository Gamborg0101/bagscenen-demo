# Local development (docker compose up -d)
DATABASE_URL="postgresql://bagscenen:bagscenen@localhost:5433/bagscenen"
DATABASE_URL_UNPOOLED="postgresql://bagscenen:bagscenen@localhost:5433/bagscenen"

# Production: set automatically by the Vercel Neon integration (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct)

# Generate with: npx auth secret
AUTH_SECRET=""

# Comma-separated allowed signup domains (default: ORG.emailDomains in src/lib/org.ts)
ALLOWED_EMAIL_DOMAINS=""

# Protects /api/cron/retention (min. 32 chars). Generate: openssl rand -base64 48
CRON_SECRET=""

# Public base URL used in reset/invite/booking links (required in production)
APP_URL="http://localhost:3100"

# Shown on the privacy page as the contact for data questions (e.g. the coordinator's work mail)
PRIVACY_CONTACT_EMAIL=""
